# Copy this file to .env and fill in the values
# Never commit .env to version control

# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional - Admin user IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Optional - Database path (defaults to osint_bot.db in current directory)
DB_PATH=osint_bot.db

# Optional - External API keys for enhanced results
# DEHASHED_API_KEY=your_dehashed_key_here
# HUNTER_API_KEY=your_hunter_io_key_here
